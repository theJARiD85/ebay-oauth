# Set these as Function variables in the Appwrite Console. Do not put them in
# Expo EXPO_PUBLIC_* variables or the mobile .env file.
EBAY_OAUTH_ENVIRONMENT=sandbox
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_SANDBOX_RUNAME=
EBAY_PRODUCTION_RUNAME=
# Base64-encoded random 32-byte key. Keep it secret and stable after launch.
EBAY_TOKEN_ENCRYPTION_KEY=
# Keep this minimal until a feature needs another eBay user scope.
EBAY_OAUTH_SCOPES=https://api.ebay.com/oauth/api_scope
