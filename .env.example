# Set these as Function variables in the Appwrite Console. Do not put them in
# Expo EXPO_PUBLIC_* variables or the mobile .env file.
EBAY_SANDBOX_CLIENT_ID=
EBAY_SANDBOX_CLIENT_SECRET=
EBAY_PRODUCTION_CLIENT_ID=
EBAY_PRODUCTION_CLIENT_SECRET=
EBAY_SANDBOX_RUNAME=
EBAY_PRODUCTION_RUNAME=
# Each of these must be its own Base64-encoded random 32-byte key.
EBAY_TOKEN_ENCRYPTION_KEY=
EBAY_USER_ID_HMAC_KEY=
# The Function adds its required base and Commerce Identity scopes automatically.
EBAY_OAUTH_SCOPES=
